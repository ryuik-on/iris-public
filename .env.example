# --- System Configuration ---
PORT=3002
NODE_ENV=development
ASSISTANT_NAME=IRIS

# --- AI API Keys ---
ANTHROPIC_API_KEY=
# 省略時は claude-opus-5。ANTHROPIC_EFFORT: low/medium/high/xhigh/max（既定 high）
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
OPENAI_API_KEY=
REVIEW_PRIMARY_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Google Workspace OAuth2 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# --- LINE & WebClass ---
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=
WEBCLASS_URL=

# --- Mobile Device Edge (iOS Shortcuts) ---
IRIS_MOBILE_TOKEN=

# --- Research tools (web_search / pubmed_* / jrct_search) ---
# All optional. web_search uses Tavily if its key is set, then Brave, else DuckDuckGo.
# WEB_SEARCH_PROVIDER: tavily / brave / duckduckgo (overrides the order above)
WEB_SEARCH_PROVIDER=
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# Without a key NCBI allows 3 requests/s; with one, 10.
NCBI_API_KEY=
NCBI_EMAIL=
# jRCT search page, with {query} where the words go. Empty uses the built-in default.
JRCT_SEARCH_URL=

# --- File access ---
# Read-only places outside IRIS_Workspace, colon-separated (~ allowed). Writing and
# deleting stay inside the workspace. Secrets (.env, keys, *.db, Library, ~/.iris,
# ~/.claude ...) are refused even inside these. Empty means the workspace only.
IRIS_READ_ROOTS=
# Places outside IRIS_Workspace where write_file may write, behind the approval screen.
# Never IRIS's own code, hidden files directly under ~, Library or Applications.
# Outside the workspace the default is create_only (an existing file is not replaced).
IRIS_WRITE_ROOTS=
